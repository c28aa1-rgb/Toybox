# Copy to ../../.env on the Mac mini (setup.sh does this for you) and chmod 600 it.
# The server listens only on this machine; a tunnel (Tailscale Funnel / Cloudflare Tunnel) exposes it.
GG_PORT=8080
GG_HOST=127.0.0.1
NODE_ENV=production

# The GitHub Pages site that is allowed to connect (origin only, no path, no trailing slash).
ALLOWED_ORIGINS=https://c28aa1-rgb.github.io

# Firebase Admin credentials: a service-account key file kept OUTSIDE the project folder.
# Firebase console > Project settings > Service accounts > Generate new private key.
GOOGLE_APPLICATION_CREDENTIALS=/Users/CHANGE_ME/toybox-secrets/firebase-key.json
FIREBASE_PROJECT_ID=toybox-takedown

# Per-IP socket cap. Raise this if the tunnel does not forward the real client IP
# (then everyone looks like one address and the default of 8 would lock people out).
GG_MAX_CONN_PER_IP=64
